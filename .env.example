DB_NAME=
DB_PORT=5432
DDL=update
SHOW_SQL=false

# Postgres 슈퍼유저 (컨테이너 관리용, 애플리케이션 미사용)
DB_USER=
DB_PASSWORD=

# 서비스별 DB 계정 (각 서비스는 자기 스키마만 접근 가능)
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=
HUB_DB_USER=hub_svc
HUB_DB_PASSWORD=
COMPANY_DB_USER=company_svc
COMPANY_DB_PASSWORD=
ORDER_DB_USER=order_svc
ORDER_DB_PASSWORD=
DELIVERY_DB_USER=delivery_svc
DELIVERY_DB_PASSWORD=

# 레디스
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 토큰 키
JWT_SECRET_KEY=

# Slack 알림 (선택). 비워 두면 알림을 보내지 않음. Webhook URL은 비밀값이라 공유·커밋 금지
SLACK_WEBHOOK_URL=

# 상품 조회 캐시 단계 (선택, company-ms). none(기본): 캐시 없음 · redis · layered(Caffeine+Redis). 캐시 단계는 Redis 필요
PRODUCT_CACHE_MODE=none
